rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything is written/read through the server (Firebase Admin SDK),
    // which bypasses these rules. Deny all direct client access so users
    // cannot tamper with users/sessions/withdrawals or the config doc.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
