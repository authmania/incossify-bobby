rules_version = '2';
// NOTE: this app authenticates to Firestore with the SAME web SDK credentials
// the legacy Incossify/Nextel apps use (public API key). Those apps wrote
// directly from the browser, so this project's deployed rules already permit
// these operations. Rules can only be hardened to deny-all client access once
// this app runs on a privileged credential (Firebase Admin SDK / service
// account) instead of the public web key. See README.
service cloud.firestore {
  match /databases/{database}/documents {
    match /account/{account} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
